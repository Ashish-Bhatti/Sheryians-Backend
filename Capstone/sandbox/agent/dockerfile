FROM node:24-bullseye

# Install  build dependencies for native modules (node-pty)
# 'make' , "g++" and "python3" are required for node-gyp to compile c++ code
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
       bash \
       python3 \
       make \
       g++ \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY package*.json .

RUN npm install

COPY . .

EXPOSE 3000

RUN mkdir /workspace

CMD ["node", "server.js"]